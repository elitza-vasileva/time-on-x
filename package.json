{
  "name": "time-on-x-extension",
  "version": "1.5.3",
  "private": true,
  "type": "module",
  "description": "A privacy-first Chrome extension for tracking active time on X.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:web": "node scripts/build-web.mjs",
    "test": "node --test",
    "icons": "powershell -ExecutionPolicy Bypass -File scripts/generate-icons.ps1",
    "package": "npm run build && powershell -ExecutionPolicy Bypass -File scripts/package.ps1",
    "configure:profile": "node scripts/configure-profile.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@instantdb/core": "^1.0.49",
    "datafast": "^3.0.18"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
